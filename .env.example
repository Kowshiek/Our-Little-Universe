# ============================================
# OUR LITTLE UNIVERSE - ENVIRONMENT CONFIGURATION
# ============================================

# Server Port and Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret for Session Authentication (Change in production!)
JWT_SECRET=super_secret_cosmic_jwt_key_love_universe_2026_change_me

# Client URL (for CORS and Socket.IO origin)
CLIENT_URL=http://localhost:5173

# Optional: Supabase credentials (if connecting to managed Supabase PostgreSQL)
# Leave empty to use the built-in resilient SQLite local persistence engine!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
